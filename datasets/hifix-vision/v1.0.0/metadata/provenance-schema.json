{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HiFixVisionImageProvenance",
  "type": "object",
  "required": [
    "image_id",
    "source_type",
    "source_name",
    "source_url",
    "license",
    "license_version",
    "commercial_use_approved",
    "ml_training_approved",
    "attribution_required",
    "collection_date",
    "class_label",
    "annotator_id",
    "consent_status",
    "privacy_sanitized",
    "exif_stripped",
    "sha256_hash",
    "perceptual_hash",
    "dataset_version"
  ],
  "properties": {
    "image_id": { "type": "string" },
    "source_type": { "type": "string", "enum": ["hifix_original", "open_source_verified", "synthetic_approved"] },
    "source_name": { "type": "string" },
    "source_url": { "type": "string" },
    "license": { "type": "string" },
    "license_version": { "type": "string" },
    "commercial_use_approved": { "type": "boolean" },
    "ml_training_approved": { "type": "boolean" },
    "attribution_required": { "type": "boolean" },
    "collection_date": { "type": "string" },
    "class_label": { "type": "string" },
    "annotator_id": { "type": "string" },
    "consent_status": { "type": "string", "enum": ["CONSENT_VERIFIED", "CONSENT_PENDING", "CONSENT_REJECTED", "NOT_APPLICABLE"] },
    "privacy_sanitized": { "type": "boolean" },
    "exif_stripped": { "type": "boolean" },
    "sha256_hash": { "type": "string" },
    "perceptual_hash": { "type": "string" },
    "dataset_version": { "type": "string" }
  }
}

# Database Configuration
DB_HOST=192.168.189.251
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=hifix_db

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d

# Email Configuration for OTP
# For Gmail: 
# 1. Enable 2-factor authentication
# 2. Generate an App Password from: https://myaccount.google.com/apppasswords
# 3. Use the app password below (not your regular password)
EMAIL_USER=kavithashridhar.9898@gmail.com
EMAIL_PASSWORD=123456

# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# ── Phase 5: AI Infrastructure ────────────────────────────────────────────────
# Master switch: keep false until a valid API key is configured.
AI_ENABLED=false

# Provider: 'google-gemini' (recommended) or 'openai'
AI_PROVIDER=google-gemini
# API key for the selected provider. Do NOT commit real keys.
AI_API_KEY=your_api_key_here

# Model (provider-specific)
AI_MODEL=gemini-2.0-flash

# Generation config
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.3

# Timeout and retry
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=3
AI_RETRY_DELAY_MS=1000

# Rate limits: requests per AI_RATE_LIMIT_WINDOW_MS per user type
AI_RATE_LIMIT_USER=10
AI_RATE_LIMIT_WORKER=20
AI_RATE_LIMIT_IMAGE=5
AI_RATE_LIMIT_WINDOW_MS=60000

# Cache: keep false in Phase 5.0 — each feature activates its own cache
AI_CACHE_ENABLED=false
AI_CACHE_TTL_MS=3600000

# Image validation
AI_IMAGE_MAX_SIZE_MB=10
AI_IMAGE_ALLOWED_TYPES=jpeg,jpg,png,webp
AI_IMAGE_CLEANUP_AFTER_MS=3600000

# Logging: debug|info|warn|error
AI_LOG_LEVEL=info
